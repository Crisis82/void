# Template file for 'discord'
pkgname=discord
version=1.0.158
revision=1
archs="x86_64"
depends="alsa-lib dbus-glib gtk+3 libnotify nss libXtst libcxx libatomic
 xdg-utils webrtc-audio-processing libXScrnSaver"
short_desc="Discord application"
maintainer="Crisis82 <crisis82@users.noreply.github.com>"
license="custom:Proprietary"
homepage="https://discord.com"
distfiles="https://dl.discordapp.net/apps/linux/${version}/discord-${version}.tar.gz"
checksum=3650a40e831c8e57f0f915f7fe5423c6b438e46301b10537fb10d49dd5148e0d
restricted=yes
nopie=yes
nostrip=yes

do_install() {
	local package_location="usr/lib/$pkgname" item
	local discord_bin=""
	vmkdir usr/share/pixmaps
	vcopy discord.png /usr/share/pixmaps/
	vmkdir usr/share/applications
	vcopy discord.desktop /usr/share/applications/
	vmkdir ${package_location}

	for item in *; do
		vcopy "${item}" "${package_location}"
	done

	if [ -f discord ]; then
		chmod +x discord
		discord_bin=discord
	elif [ -f Discord ]; then
		chmod +x Discord
		discord_bin=Discord
	else
		msg_error "discord executable not found in distfiles\n"
	fi

	vmkdir usr/bin
	ln -sfr "$DESTDIR/${package_location}/${discord_bin}" "$DESTDIR/usr/bin/discord"
	ln -sfr "$DESTDIR/${package_location}/${discord_bin}" "$DESTDIR/usr/bin/Discord"
}

post_install() {
	vlicense $FILESDIR/LICENSE
}
