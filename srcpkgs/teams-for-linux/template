# Template file for 'teams-for-linux'
pkgname=teams-for-linux
version=2.14.1
revision=1
archs="x86_64"
hostmakedepends="binutils tar xz"
depends="alsa-lib at-spi2-core gtk+3 libnotify libsecret nss libXScrnSaver libXtst xdg-utils util-linux-libs"
short_desc="Unofficial Microsoft Teams desktop client"
maintainer="Crisis82 <crisis82@users.noreply.github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/IsmaelMartinez/teams-for-linux"
distfiles="${homepage}/releases/download/v${version}/teams-for-linux_${version}_amd64.deb"
checksum=c65281d7991d8cec60903d852e5b2a8d8b831d6f7dd032ea7f6b63030aa7a504
nopie=yes
nostrip=yes
wrksrc="${pkgname}-${version}"

do_extract() {
	local deb="${XBPS_SRCDISTDIR}/${pkgname}-${version}/${distfiles##*/}"
	local data_tar

	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	ar x "${deb}"
	data_tar="$(printf '%s\n' data.tar.* | head -n1)"

	case "${data_tar}" in
		*.xz) tar -xJf "${data_tar}" ;;
		*.gz) tar -xzf "${data_tar}" ;;
		*.zst) tar --zstd -xf "${data_tar}" ;;
		*) msg_error "${pkgname}: unsupported data archive ${data_tar}\n" ;;
	esac
}

do_install() {
	vcopy opt /
	vcopy usr /

	# Remove any bundled musl libraries or binaries that may have been extracted
	# from the upstream .deb. These can trigger auto-detected run_depends for musl
	# which break glibc-based repositories.
	# 1) Remove files with musl in their filename.
	find "${DESTDIR}" -type f -iname '*musl*' -exec rm -f {} \; || true

	# 2) Remove ELF files that dynamically link against musl (safer detection).
	if command -v ldd >/dev/null 2>&1; then
		while IFS= read -r _f; do
			rm -f "$_f" || true
		done < <(find "${DESTDIR}" -type f -exec sh -c 'file -L "$1" | grep -qi "elf" && (ldd "$1" 2>/dev/null || true) | grep -qi "musl" && printf "%s\n" "$1"' _ {})
	fi
}

post_install() {
	vlicense $FILESDIR/LICENSE
}
